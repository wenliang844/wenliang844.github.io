---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { buildLayoutState } from "../templates/layout.mjs";

const state = buildLayoutState(Astro.props);
const compatibilityRuntime = "/js/coder.js";
const scripts = state.scripts.filter((src) => src !== compatibilityRuntime);
---
<script>
  import { initSiteRuntime } from "../client/site-runtime";

  initSiteRuntime();
</script>
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={state.csp} />
    <meta name="cwl-api-base" content={state.apiBase} />
    <meta name="description" content={state.description} />
    <meta name="theme-color" content="#171717" />
    <meta name="generator" content="Astro Content Collections" />
    <link rel="icon" href="/images/favicon.png" type="image/png" />
    {state.resourceHints.map(({ rel, href }) => <link rel={rel} href={href} />)}
    <link rel="stylesheet" href="/css/fontawesome-all.min.css" />
    <link rel="stylesheet" href={state.mainStyle} />
    <link rel="stylesheet" href="/css/content.min.css" />{state.styles.map((href) => <link rel="stylesheet" href={href} />)}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/images/pwa-192.png" />
    {scripts.map((src) => <script is:inline src={src} defer></script>)}
    {state.openGraph.map((tag) => tag.tag === "link"
      ? <link rel={tag.rel} href={tag.href} />
      : <meta name={tag.name} property={tag.property} content={tag.content} />)}
    {state.jsonLdSource ? <script is:inline type="application/ld+json" set:html={state.jsonLdSource}></script> : null}
    <title>{state.title}</title>
  </head>
  <body
    class={state.bodyClass}
    data-i18n-page={state.page || undefined}
    data-i18n-title-en={state.titleEn || undefined}
    data-i18n-desc-en={state.descriptionEn || undefined}
    data-language-mode={state.languageMode}
    data-cwl-comments={state.comments ? "enabled" : undefined}
  >
    <a class="skip-link" href="#main-content" data-i18n="nav.skip">跳到主要内容</a>
    <div class="cursor-glow" aria-hidden="true"></div>
    <canvas class="cursor-canvas" aria-hidden="true"></canvas>
    <div class="site-shell">
      <SiteHeader active={state.active} languageMode={state.languageMode} /><slot /><SiteFooter />
    </div>
  </body>
</html>
