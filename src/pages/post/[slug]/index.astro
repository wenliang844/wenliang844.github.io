---
import {
  buildSeriesContext,
  collectSeries,
  relatedPosts,
} from "../../../../scripts/build.mjs";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticlePage from "../../../components/ArticlePage.astro";
import { buildPostPageMetadata } from "../../../templates/post.mjs";
import { getPublishedPosts } from "../../../lib/astro-posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const posts = await getPublishedPosts();
const postIndex = posts.findIndex((candidate) => candidate.slug === Astro.params.slug);
if (postIndex === -1) throw new Error(`Unknown post route: ${Astro.params.slug}`);

const post = posts[postIndex];
const seriesGroups = collectSeries(posts);
const nav = {
  prev: posts[postIndex - 1] || null,
  next: posts[postIndex + 1] || null,
  related: relatedPosts(post, posts),
  backlinks: post.backlinks,
  series: buildSeriesContext(post, seriesGroups),
};
const layout = buildPostPageMetadata(post, nav);
---
<BaseLayout {...layout}>
  <ArticlePage {post} {nav} />
</BaseLayout>
