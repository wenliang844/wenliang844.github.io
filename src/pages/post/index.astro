---
import { buildStats } from "../../../scripts/build.mjs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostListPage from "../../components/PostListPage.astro";
import { buildPostListPageMetadata } from "../../templates/post.mjs";
import { getPublishedPosts } from "../../lib/astro-posts";

const posts = await getPublishedPosts();
const stats = buildStats(posts);
const layout = buildPostListPageMetadata(posts);
---
<BaseLayout {...layout}>
  <PostListPage {posts} {stats} />
</BaseLayout>
