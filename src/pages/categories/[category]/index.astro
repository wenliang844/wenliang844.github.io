---
import { collectCategories } from "../../../../scripts/build.mjs";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TaxonomyDetailPage from "../../../components/TaxonomyDetailPage.astro";
import { getPublishedPosts } from "../../../lib/astro-posts";
import { buildTaxonomyDetailPageMetadata } from "../../../templates/taxonomy.mjs";

export async function getStaticPaths() {
  const groups = collectCategories(await getPublishedPosts());
  return groups.map((group) => ({ params: { category: group.id }, props: { group } }));
}

const group = Astro.props.group;
const page = buildTaxonomyDetailPageMetadata(group, "category");
---
<BaseLayout {...page}>
  <TaxonomyDetailPage {group} kind="category" />
</BaseLayout>
